# Local defaults need no cloud credentials.
APP_NAME=document-ingestion-service
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./data/documents.db
AUTO_CREATE_SCHEMA=true
STORAGE_BACKEND=local
STORAGE_PATH=./data/objects
QUEUE_BACKEND=local
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
S3_BUCKET=documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_UNCOMPRESSED_BYTES=52428800
MAX_ZIP_MEMBERS=2000
MAX_TEXT_CHARS=5000000
CHUNK_SIZE=1200
CHUNK_OVERLAP=120
MAX_RETRIES=3
CORS_ORIGINS=http://localhost:3000
